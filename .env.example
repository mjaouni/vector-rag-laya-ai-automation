# COPY TO .env. Example token is ONLY for localhost proof of concept.
WORKFLOW_TOKEN=local-dev-only-change-me
DECISION_PROVIDER=laya
OLLAMA_URL=http://127.0.0.1:11434
# IMPORTANT: exact name MUST match 'ollama list' on your machine.
OLLAMA_MODEL=qwen2.5:7b
QDRANT_COLLECTION=hvac_kb_minilm_v1
QDRANT_PATH=data/qdrant
DOCS_DIR=sample_docs
NOTIFICATION_DB=data/notifications.sqlite3
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MIN_RELEVANCE=0.20
TOP_K=4
# FastAPI runs on Windows. Mailpit Docker container must expose host SMTP port 1025.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=rag-demo@example.test
MAIL_TO=reviewer@example.test
N8N_WEBHOOK_URL=http://localhost:5678/webhook/rag-laya-intake
